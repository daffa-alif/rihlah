# Copy to .env and adjust. .env is gitignored.
PROJECT_NAME=Rihlah API
VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- KYC (app/services/kyc/) ---------------------------------------------
# Absolute path to tesseract.exe if it isn't on PATH. Windows default:
# KYC_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
KYC_OCR_LANGUAGES=ind+eng

KYC_MAX_UPLOAD_MB=8
KYC_MIN_DRIVER_AGE=17
KYC_SIM_EXPIRY_WARNING_DAYS=30
KYC_MAX_VEHICLE_AGE_YEARS=10
KYC_NAME_MATCH_THRESHOLD=0.82
KYC_FACE_MATCH_THRESHOLD=0.55
KYC_LIVENESS_THRESHOLD=0.5

# Service-area geofence (default covers all of Indonesia).
KYC_SERVICE_AREA_SOUTH=-11.0
KYC_SERVICE_AREA_NORTH=6.0
KYC_SERVICE_AREA_WEST=95.0
KYC_SERVICE_AREA_EAST=141.0

# Liveness: how many selfie frames a request must/may submit.
KYC_MIN_LIVENESS_FRAMES=5
KYC_MAX_LIVENESS_FRAMES=40
KYC_REQUIRE_BLINK=true

# Dukcapil identity confirmation is a stub until real credentials exist —
# these are unused for now (see app/services/kyc/dukcapil.py).
# KYC_DUKCAPIL_BASE_URL=
# KYC_DUKCAPIL_API_KEY=
