{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "monorepo": true,
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "matching-worker": {
      "type": "application",
      "root": "apps/matching-worker",
      "entryFile": "main",
      "sourceRoot": "apps/matching-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/matching-worker/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "matching": {
      "type": "library",
      "root": "libs/matching",
      "entryFile": "index",
      "sourceRoot": "libs/matching/src",
      "compilerOptions": {
        "tsConfigPath": "libs/matching/tsconfig.lib.json"
      }
    },
    "payment": {
      "type": "library",
      "root": "libs/payment",
      "entryFile": "index",
      "sourceRoot": "libs/payment/src",
      "compilerOptions": {
        "tsConfigPath": "libs/payment/tsconfig.lib.json"
      }
    },
    "firebase": {
      "type": "library",
      "root": "libs/firebase",
      "entryFile": "index",
      "sourceRoot": "libs/firebase/src",
      "compilerOptions": {
        "tsConfigPath": "libs/firebase/tsconfig.lib.json"
      }
    }
  }
}
